---
---

<section id="shows" class="shows-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">SHOWS</h2>
    </div>

    <div class="shows-content">
      <div class="bandsintown-widget">
        <a class="bit-widget-initializer"
          data-artist-name="id_15559917"
          data-display-local-dates="false"
          data-display-past-dates="true"
          data-auto-style="false"
          data-text-color="#3D0C02"
          data-link-color="#FF5500"
          data-background-color="rgba(0,0,0,0)"
          data-display-limit="10"
          data-link-text-color="#FFF5E6"
          data-display-lineup="false"
          data-display-play-my-city="true"
          data-separator-color="rgba(61,12,2,0.2)"
        ></a>
      </div>

      <div class="bandsintown-link">
        <a href="https://www.bandsintown.com/a/15559917-sunkissed" target="_blank" rel="noopener noreferrer">View all shows on Bandsintown →</a>
      </div>

      <div class="recent-shows">
        <span class="venues-label">RECENT SHOWS</span>
        <ul class="show-list">
          <li class="show-row">
            <span class="show-date">May 30, 2026</span>
            <span class="show-venue">SF Porchfest</span>
            <span class="show-city">San Francisco, CA</span>
          </li>
          <li class="show-row">
            <span class="show-date">May 17, 2026</span>
            <span class="show-venue">Hook &amp; Ladder Vineyards</span>
            <span class="show-city">Santa Rosa, CA</span>
          </li>
          <li class="show-row">
            <span class="show-date">May 15, 2026</span>
            <span class="show-venue">Neck of the Woods</span>
            <span class="show-city">San Francisco, CA</span>
          </li>
        </ul>
      </div>

      <div class="booking-info">
        <p>For booking inquiries:</p>
        <a href="mailto:sunkissed.hills@gmail.com">sunkissed.hills@gmail.com</a>
      </div>
    </div>
  </div>
</section>

<script src="https://widgetv3.bandsintown.com/main.min.js" charset="utf-8"></script>

<style>
  .shows-section {
    background: var(--cream-paper);
    padding: 4rem 0 3rem;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .section-title {
    font-family: 'Anton', sans-serif;
    font-size: 4rem;
    letter-spacing: 0.05em;
    color: var(--burnt-umber);
    text-shadow: 4px 4px 0 var(--acid-yellow);
  }

  .shows-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .bandsintown-widget {
    margin-bottom: 1.5rem;
    min-height: 80px;
  }

  .bandsintown-link {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .bandsintown-link a {
    font-family: 'Anton', sans-serif;
    font-size: 1rem;
    letter-spacing: 2px;
    color: var(--psychedelic-orange);
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .bandsintown-link a:hover {
    color: var(--electric-purple);
  }

  .recent-shows {
    padding: 2rem 0 0.5rem;
    border-top: 3px dashed var(--burnt-umber);
  }

  .recent-shows .venues-label {
    text-align: center;
  }

  .show-list {
    list-style: none;
    max-width: 560px;
    margin: 0 auto;
  }

  .show-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid rgba(61, 12, 2, 0.15);
  }

  .show-date {
    font-family: 'Anton', sans-serif;
    font-size: 1rem;
    letter-spacing: 1px;
    color: var(--psychedelic-orange);
    white-space: nowrap;
  }

  .show-venue {
    font-family: 'Anton', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 1px;
    color: var(--burnt-umber);
  }

  .show-city {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--burnt-umber);
    opacity: 0.6;
    white-space: nowrap;
  }

  .venues-label {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 4px;
    color: var(--burnt-umber);
    opacity: 0.5;
    display: block;
    margin-bottom: 1rem;
  }

  .booking-info {
    text-align: center;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 3px dashed var(--burnt-umber);
  }

  .booking-info p {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.9rem;
    color: var(--burnt-umber);
    opacity: 0.7;
    margin-bottom: 0.5rem;
  }

  .booking-info a {
    font-family: 'Anton', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 2px;
    color: var(--psychedelic-orange);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .booking-info a:hover {
    color: var(--electric-purple);
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: 3rem;
    }

    .show-row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
      text-align: center;
      padding: 1rem 0;
    }
  }
</style>
